# ─── CloakBrowser Login Bot Configuration ───

# 🌐 লগইন পেজের URL (required)
LOGIN_URL=https://example.com/login

# 🔑 ইউজার আইডি বা ইমেইল (required)
USER_ID=your_username_here

# 🔐 পাসওয়ার্ড (required)
PASSWORD=your_password_here

# 🎯 CSS সিলেক্টর — আপনার সাইট অনুযায়ী পরিবর্তন করুন
# ডিফল্টভাবে কমন সিলেক্টর ব্যবহার হয়
USER_ID_SELECTOR=input[name="username"], input[type="text"], input[name="email"]
PASSWORD_SELECTOR=input[type="password"]
SUBMIT_SELECTOR=button[type="submit"], input[type="submit"]

# ⚙️ সেটিংস
HEADLESS=false
HUMANIZE=true

# 🌐 প্রক্সি (optional — বাংলাদেশি IP পেতে ব্যবহার করুন)
# PROXY=socks5://user:pass@host:port
# PROXY=http://user:pass@host:port

# 🤖 LLM Agent (Groq) — adaptive Veo 3 bot এর জন্য
# Groq dashboard থেকে API key নিন: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 🔁 Cohere fallback — Groq TPM/413/rate-limit hit করলে auto-use হবে।
# Model: command-a-reasoning-08-2025 (thinking enabled, JSON mode)
# Cohere dashboard: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=your_cohere_key_here

# 🎯 Target Veo model (UI-তে যে exact label আছে সেটা)
VEOPRO_MODEL=Veo 3.1 - Fast

# 🧠 Agent behavior
AGENT_MAX_STEPS=50
AGENT_USE_VISION=true
